# MongoDB local (sin credenciales)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=reto_vivienda

# Kafka: sustituir por los parámetros de vuestro broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=anuncios_vivienda
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=
KAFKA_GROUP_ID=consumidor_anuncios_mongodb
KAFKA_NUM_PARTITIONS=1
KAFKA_REPLICATION_FACTOR=1

# HDFS/WebHDFS: sustituir por la URL, usuario y ruta de vuestro entorno
HDFS_URL=http://localhost:9870
HDFS_USER=
HDFS_BASE_PATH=/reto_vivienda
